# ==============================================================================
# Portfolio Environment Variables Template
# Copy this file to `.env` and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server / Nitro Runtime
# ------------------------------------------------------------------------------
NITRO_PORT=3000
NITRO_HOST=0.0.0.0
NODE_ENV=development

# ------------------------------------------------------------------------------
# Nodemailer SMTP Email Configuration (server/api/contact.post.ts)
# ------------------------------------------------------------------------------
# Note: If SMTP variables are omitted, the contact API falls back to
# nodemailer JSON transport mode in development, logging messages safely
# without attempting live SMTP connection.

# SMTP Server host (e.g., smtp.gmail.com, smtp.mailgun.org, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP Server port (465 for SSL/TLS, 587 for STARTTLS)
SMTP_PORT=465

# SMTP Authentication Credentials
# For Gmail: Use your full Gmail address and an App Password (generated in Google Account -> Security -> App Passwords)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Sender Display Name and Email in outgoing headers
SMTP_FROM="Portfolio Contact Form <noreply@auliaggr.com>"

# Destination Email where contact inquiries are forwarded
CONTACT_TO_EMAIL=auliaggrr@gmail.com
